# Reverse proxy for getxmatch with WebSocket (socket.io) support.
# Put this in /etc/nginx/sites-available/getxmatch and symlink into sites-enabled.
# Replace example.com with your domain. Get TLS with:  sudo certbot --nginx -d example.com

server {
    listen 80;
    server_name example.com;

    # Allow chat file relays / gallery uploads up to a sensible cap.
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # Required for socket.io WebSocket upgrade.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;
    }
}
