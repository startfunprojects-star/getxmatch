# Copy this file to .env and fill in real values before running in production.

# Port the app listens on
PORT=3000

# Secret used to sign auth tokens (JWT). MUST be long & random in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Set to "production" on your VPS. Enables secure cookies (requires HTTPS).
NODE_ENV=development

# Max profile/gallery image upload size in megabytes
MAX_UPLOAD_MB=5

# Max ephemeral chat file size in megabytes (relayed live, never stored)
MAX_CHAT_FILE_MB=15

# Public base URL of the site — used to build absolute links inside emails AND
# every canonical URL, Open Graph tag, sitemap entry and JSON-LD block for SEO.
# In production set this to your real https URL, e.g. https://getxmatch.com
PUBLIC_URL=http://localhost:3000

# Optional SEO extras. TWITTER_HANDLE feeds the Twitter card `site` tag
# (e.g. @getxmatch). SOCIAL_LINKS is a comma-separated list of your social
# profile URLs, emitted as Organization `sameAs` for the Knowledge Graph.
# TWITTER_HANDLE=@getxmatch
# SOCIAL_LINKS=https://twitter.com/getxmatch,https://instagram.com/getxmatch

# Admin: the password set/reset link is emailed to this address.
ADMIN_EMAIL=gauravsharma.ps@gmail.com

# Signup OTP settings
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5

# Admin reset link lifetime (minutes)
ADMIN_RESET_TTL_MIN=60

# Outgoing email (Hostinger SMTP). Leave SMTP_USER/SMTP_PASS blank during
# local testing — the app will print OTPs and reset links to the console
# instead of sending real email. Fill these in to send for real.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# "From" header. Usually the same mailbox as SMTP_USER.
MAIL_FROM=getxmatch <no-reply@getxmatch.com>
